# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage

# Environments / secrets
.env
*.key

# Large local artifacts (manifests + hashes are committed instead)
projects/*/results/raw/**
projects/*/upstream/checkout/**
vendor/checkouts/**
!projects/*/results/raw/.gitkeep

# Downloaded papers: kept local only (license-safe); hashes live in corpus.jsonl
projects/*/research/pdfs/**

# Live training logs churn every second; immutable copies land in results/raw/ on completion
projects/*/upstream/*.log

# OS
Thumbs.db
.DS_Store
