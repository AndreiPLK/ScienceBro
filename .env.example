# ScienceBro environment variables (copy to .env, never commit .env)
# All optional in V1. Core works without any keys.

# Semantic Scholar API key (optional, raises rate limits)
S2_API_KEY=

# OpenAlex polite-pool email (optional)
OPENALEX_MAILTO=

# Zotero (optional, for library sync)
ZOTERO_API_KEY=
ZOTERO_USER_ID=
