\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The allowed body at linear scale with the near-leading shore overlaid; every cell is an exact rational verdict (all even spins, depth 14).}}{3}{figure.2}\protected@file@percent }
