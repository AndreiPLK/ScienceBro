\@writefile{toc}{\contentsline {section}{\numberline {4}Virasoro--Shapiro thresholds}{3}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The same boundary as a landscape (every point an exact rational verdict). Height is the depth to which a candidate survives the positivity tests: the cyan plateau is the allowed region, the wall falls exactly along $\min _n T_n(\lambda )$, and the floor is the excluded region. The yellow lane is the string ($\lambda =1$) walking the plateau as $D$ grows; the white diamond marks $D=23$, where the shore passes exactly through it. For $D<9$ there is no wall at all.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:cliff3d}{{3}{4}{The same boundary as a landscape (every point an exact rational verdict). Height is the depth to which a candidate survives the positivity tests: the cyan plateau is the allowed region, the wall falls exactly along $\min _n T_n(\lambda )$, and the floor is the excluded region. The yellow lane is the string ($\lambda =1$) walking the plateau as $D$ grows; the white diamond marks $D=23$, where the shore passes exactly through it. For $D<9$ there is no wall at all}{figure.3}{}}
